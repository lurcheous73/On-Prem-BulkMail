[Unit]
Description=Renew and verify enrolled local certificate lineage %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/grange-certificate-renewal/local_lineage.py --config /etc/grange-certificate-renewal/lineages/%i.json
TimeoutStartSec=1h

