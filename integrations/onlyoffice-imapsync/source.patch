+    private void WithEngineLock(Action action)
+    {
+        _enginesFactorySemaphore.Wait();
+        try
+        {
+            action();
+        }
+        finally
+        {
+            _enginesFactorySemaphore.Release();
+        }
+    }
+
+    private void CompleteFolderUpdate(Action recalculateFolders)
