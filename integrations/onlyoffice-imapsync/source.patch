+    private void RestoreMissingDrafts(SimpleImapClient draftClient, List<MailInfo> pendingDrafts,
+        Action<CashedMailUserAction> restore)
+    {
+        var sentClient = simpleImapClients.FirstOrDefault(x =>
+            x.Account.MailBoxId == draftClient.Account.MailBoxId &&
+            x.ImapMessagesList != null && x.ImapWorkFolder != null && x.Folder == FolderType.Sent);
+        var sentMessages = sentClient?.ImapMessagesList?.ToArray();
+
+        // Unknown Sent state must not be interpreted as an unsent draft.
+        if (sentMessages == null)
+        {
+            deferredDraftRecovery.TryAdd(draftClient.Account.MailBoxId, 0);
+            return;
+        }
+
+        deferredDraftRecovery.TryRemove(draftClient.Account.MailBoxId, out _);
+        var ids = pendingDrafts
+            .Where(draft => !sentMessages.Any(sent => sent.IMAPMessageId == draft.MimeMessageId))
+            .Select(draft => draft.Id).ToList();
+
+        if (ids.Any())
+        {
+            restore(new CashedMailUserAction { Action = MailUserAction.UpdateDrafts, Uds = ids });
+        }
+    }
+
+    private void RetryDraftRecoveryForSentClient(SimpleImapClient sentClient,
+        Action<SimpleImapClient> updateDraft)
+    {
+        if (sentClient.ImapMessagesList == null || sentClient.Folder != FolderType.Sent ||
+            !deferredDraftRecovery.TryRemove(sentClient.Account.MailBoxId, out _))
+        {
+            return;
+        }
+
+        // Called after UpdateDbFolder releases the engine semaphore.
+        var draftClients = simpleImapClients.Where(x =>
+            x.Account.MailBoxId == sentClient.Account.MailBoxId &&
+            x.ImapMessagesList != null && x.Folder == FolderType.Draft).ToList();
+
+        foreach (var draftClient in draftClients)
+        {
+            updateDraft(draftClient);
+        }
+    }
