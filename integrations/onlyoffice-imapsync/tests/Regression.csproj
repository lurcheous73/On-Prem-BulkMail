<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <ImapSyncBuildRoot Condition="'$(ImapSyncBuildRoot)' == ''">/tmp/onlyoffice-imapsync-service-build-v3</ImapSyncBuildRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ImapSyncBuildRoot)/ASC.Mail.ImapSync.Service.csproj" />
    <Reference Include="ASC.Mail.Core">
      <HintPath>$(ImapSyncBuildRoot)/refs/ASC.Mail.Core.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
