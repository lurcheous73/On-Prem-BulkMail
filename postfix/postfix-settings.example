# These values are written by install.sh.

relayhost = [smtp.example.invalid]:25
smtp_helo_name = bulkmail.example.invalid

# Existing Brimstone On-Prem BulkMail drip behaviour.
smtp_destination_concurrency_limit = 1
smtp_destination_recipient_limit = 1
smtp_initial_destination_concurrency = 1
smtp_transport_rate_delay = 8s
