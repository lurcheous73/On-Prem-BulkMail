# Generate a private token: openssl rand -hex 32
GATEWAY_TOKEN=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_DATA_DIR=/var/lib/bulkmail-whatsapp
# Leave false until the administrator is ready to link an account.
GATEWAY_ENABLED=false
# Pairing/receipts can work while outbound delivery remains disabled.
GATEWAY_SEND_ENABLED=false
GATEWAY_MIN_INTERVAL_MS=8000
# Keep below the bundled PHP caller's 20-second HTTP timeout.
GATEWAY_SEND_TIMEOUT_MS=15000
