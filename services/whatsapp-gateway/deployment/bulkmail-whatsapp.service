[Unit]
Description=On-Prem BulkMail WhatsApp gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bulkmail-whatsapp
Group=bulkmail-whatsapp
WorkingDirectory=/opt/bulkmail-whatsapp
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/bulkmail-whatsapp.env
ExecStart=/usr/bin/env node /opt/bulkmail-whatsapp/src/main.mjs
Restart=on-failure
RestartSec=20
TimeoutStopSec=30
StateDirectory=bulkmail-whatsapp
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bulkmail-whatsapp
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
